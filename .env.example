[TEMPLATE]
DATABASE_URL="PASTE_YOUR_POSTGRESQL_CONNECTION_STRING_HERE"

# NextAuth secret — generate with: npx auth secret
AUTH_SECRET="PASTE_A_LONG_RANDOM_SECRET_HERE"

# Google OAuth — used ONLY as the student sign-in provider (unchanged).
AUTH_GOOGLE_ID="PASTE_YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE"
AUTH_GOOGLE_SECRET="PASTE_YOUR_GOOGLE_OAUTH_CLIENT_SECRET_HERE"

# Freebuff AI API key — replaces the old GEMINI_API_KEY for AI features
# (explanation enhancement / plan summary). AI features degrade gracefully to
# deterministic templates when this is empty.
FREEBUFF_API_KEY=""
# Optional overrides for the OpenAI-compatible Freebuff endpoint
FREEBUFF_API_URL="https://api.freebuff.com/v1/chat/completions"
FREEBUFF_MODEL="freebuff-chat"

# Set to "true" (non-production only) to enable the /demo hackathon page
DEMO_MODE="false"

NEXT_PUBLIC_APP_URL="http://localhost:7000"
