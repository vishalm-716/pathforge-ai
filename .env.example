[TEMPLATE]
DATABASE_URL="PASTE_YOUR_POSTGRESQL_CONNECTION_STRING_HERE"

# NextAuth secret — generate with: npx auth secret
AUTH_SECRET="PASTE_A_LONG_RANDOM_SECRET_HERE"

# Google OAuth — used ONLY as the student sign-in provider (unchanged).
AUTH_GOOGLE_ID="PASTE_YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE"
AUTH_GOOGLE_SECRET="PASTE_YOUR_GOOGLE_OAUTH_CLIENT_SECRET_HERE"

# Freebuff AI — OPTIONAL and currently UNVERIFIED.
# Freebuff is a free CLI coding agent (freebuff.com). No public, documented
# runtime inference API or API-key issuance was found as of the last review, so
# these variables are OFF by default. If a supported endpoint is ever confirmed,
# set the key here; until then the app uses its deterministic templates and no
# network call is made. Do not rename a Google/Gemini key into this variable.
FREEBUFF_API_KEY=""
# Only used when FREEBUFF_API_KEY is set AND the endpoint is confirmed real:
FREEBUFF_API_URL=""
FREEBUFF_MODEL=""

# Set to "true" (non-production only) to enable the /demo hackathon page.
# Must be "false" (or unset) in production.
DEMO_MODE="false"

# ─── Optional: local seed controls ───────────────────────────────────────────
# The seed script NEVER creates a default admin or a public demo account.
# SEED_ADMIN_EMAIL + SEED_ADMIN_PASSWORD (min 12 chars) create a production
# admin. SEED_DEMO_DATA=true additionally creates the demo student and its
# sample plan/activity. Leave both unset for a clean production seed.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_DEMO_DATA="false"
